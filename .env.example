# PostgreSQL/Supabase. Usa Session pooler (:5432) para un servidor persistente
# o Transaction pooler (:6543) al desplegar Next.js en serverless.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"
# Conexión directa (o Session pooler si tu red no tiene IPv6) para migraciones,
# restauraciones y Prisma Studio. Nunca se envía al navegador.
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
# Máximo de conexiones por instancia del servidor Next.js.
DATABASE_POOL_MAX="10"
# Opcional: conexión PostgreSQL de pruebas. La suite crea y elimina únicamente
# un esquema aislado `lotm_test_*` dentro de esta base.
TEST_DATABASE_URL=""
# Reservadas para una futura integración con la API de Supabase. Prisma no las
# necesita para acceder directamente a PostgreSQL.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
ADMIN_PASSWORD="cambiar-esta-contrasena"
ADMIN_SESSION_SECRET="cambiar-por-un-secreto-largo"

# MCP y biblioteca independiente del generador de cartas
CARDS_DB_PATH="./data/cards.db"
CARDS_EXPORT_DIR="./data/card-exports"
# Imagenes que se suben desde el editor; en la base solo queda su ruta.
CARDS_IMAGE_DIR="./data/card-images"
CARDS_MCP_HOST="0.0.0.0"
CARDS_MCP_PORT="3101"
# Obligatorio en produccion. Genera uno largo y aleatorio; no lo compartas.
CARDS_MCP_TOKEN="reemplaza-esto-por-un-token-largo-y-aleatorio"
# Dominio HTTPS que el proxy inverso enruta hacia cards-mcp:3101.
CARDS_MCP_PUBLIC_URL="https://mcp.tu-dominio.com"
# Hostnames publicos permitidos por el servidor MCP, separados por comas.
CARDS_MCP_ALLOWED_HOSTS="mcp.tu-dominio.com"
# Pagina que se abre sola en el navegador al guardar/editar la primera carta
# de la sesion (requiere "npm run dev" corriendo). Por defecto /cartas/vivo local.
CARDS_LIVE_VIEW_URL=""
